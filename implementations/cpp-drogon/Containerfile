# C++17 Drogon API image.
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /src

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       build-essential cmake pkg-config libdrogon-dev libjsoncpp-dev libpq-dev \
       uuid-dev zlib1g-dev libsqlite3-dev \
       libmariadb-dev libmariadb-dev-compat \
       libbrotli-dev libhiredis-dev libyaml-cpp-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --parallel

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --no-install-recommends --yes libdrogon1t64 libpq5 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app app

WORKDIR /app
COPY --from=builder /src/build/backend-api-cpp /app/server
RUN mkdir -p /app/uploads/tmp \
    && chown -R app:app /app

USER app
EXPOSE 8080
ENTRYPOINT ["/app/server"]
