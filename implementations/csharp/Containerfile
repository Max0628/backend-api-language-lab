# ASP.NET Core API service image: publish in a builder and run as non-root.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS builder

WORKDIR /src
COPY BackendApiLanguageLab.CSharp.csproj ./
RUN dotnet restore

COPY . ./
RUN dotnet publish \
    --configuration Release \
    --no-restore \
    --output /out \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0

WORKDIR /app
COPY --from=builder /out ./

ENV ASPNETCORE_URLS=http://+:8080
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "BackendApiLanguageLab.CSharp.dll"]
